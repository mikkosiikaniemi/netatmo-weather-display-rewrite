# WebSocket endpoint of the local python-matter-server.
MATTER_WS_URL=ws://127.0.0.1:5580/ws

# Backend ingest endpoint (production host, or http://<pi-ip>:3001 in dev).
INGEST_URL=http://your-server:3001/api/sensors/ingest

# Shared secret from backend/.env (SENSOR_INGEST_TOKEN).
INGEST_TOKEN=

# Set to false if INGEST_URL uses a self-signed https certificate.
VERIFY_TLS=true

# Node id the sensor gets when commissioned (see commission.py output).
NODE_ID=1

# How the reading is labelled in the dashboard.
DEVICE_ID=timmerflotte
DEVICE_NAME=Timmerflotte

# Seconds between polls.
POLL_INTERVAL_SEC=600

# Matter attribute paths (endpoint/cluster/attribute).
# TIMMERFLOTTE: temperature on endpoint 1, humidity on endpoint 2.
TEMPERATURE_PATH=1/1026/0
HUMIDITY_PATH=2/1029/0

# Optional: report battery percentage. TIMMERFLOTTE exposes the PowerSource
# cluster BatteryPercentRemaining attribute on endpoint 0 (0/47/16).
# Leave empty to skip battery reporting.
#BATTERY_PATH=0/47/16

# Optional Thread Active Dataset (TLV, base64). Normally not needed when the
# controller reaches an already-joined device through the Apple/Thread border
# router; set it if commission_with_code fails with a Thread connectivity error.
#THREAD_DATASET=